{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Blover",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#lineComment"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.blover",
				"match": "\\b(int|bool|in|out|ref|assume|assert|confirm|param|mut|ret|type|refine|if)\\b"
			}]
		},
		"strings": {
			"name": "string.quoted.double.blover",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.blover",
					"match": "\\\\."
				}
			]
		},
		"lineComment": {
			"patterns": [
				{
				"name": "comment.line",
				"match": ";.*\\n?"
				}
			]
 		}
	},
	"scopeName": "source.bv"
}